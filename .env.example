# Required. Use secrets from a secret manager in production; never commit the real .env.
APP_ENV=development
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgres://scried:scried_dev_password@localhost:5432/scried
REDIS_URL=redis://:scried_dev_redis_password@127.0.0.1:6379/
JWT_SECRET=
JWT_ISSUER=https://api.scried.example
JWT_AUDIENCE=scried-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
DATABASE_MAX_CONNECTIONS=30
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://scriedd.vercel.app
PRIVATE_STORAGE_DIR=./var/private
STORAGE_BACKEND=local
# Set STORAGE_BACKEND=cloudinary and configure CLOUDINARY_URL in production for persistent private proof storage.
CLOUDINARY_URL=
MAX_UPLOAD_BYTES=5242880
TRUST_PROXY_HEADERS=false
# Configure all email settings to enable transactional email delivery.
RESEND_API_KEY=
EMAIL_FROM="Scried <no-reply@scried.com>"
FRONTEND_BASE_URL=https://your-frontend.example
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=scried-backend
SMTP_PASSWORD=tqtrwjefvkbiybzj
